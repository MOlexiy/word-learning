{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w @wl/web",
  "outputDirectory": "apps/web/dist/web/browser",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/web libs/shared package.json package-lock.json vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://wordloop-api.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/i18n/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
