// Prisma 7: URL підключення — у prisma.config.ts, клієнт генерується в src/generated/prisma.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
}

enum TeacherStatus {
  pending
  accepted
  rejected
}

model User {
  username      String         @id @db.VarChar(32)
  email         String         @unique @db.VarChar(254)
  passwordHash  String         @map("password_hash")
  role          Role
  /// Для student: вчитель, якому надіслано заявку / який прийняв учня.
  teacherId     String?        @map("teacher_id") @db.VarChar(32)
  teacherStatus TeacherStatus? @map("teacher_status")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  teacher       User?          @relation("TeacherStudents", fields: [teacherId], references: [username], onDelete: SetNull, onUpdate: Cascade)
  students      User[]         @relation("TeacherStudents")
  cards         WordCard[]
  refreshTokens RefreshToken[]
  drafts        WordDraft[]    @relation("DraftOwner")
  addedDrafts   WordDraft[]    @relation("DraftAuthor")
  draftLink     DraftLink?

  @@index([teacherId, teacherStatus])
  @@map("users")
}

model WordCard {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.VarChar(32)
  name         String   @db.VarChar(200)
  means        String   @default("")
  used         String   @default("")
  n            String   @default("") @db.VarChar(200)
  v            String   @default("") @db.VarChar(200)
  adj          String   @default("") @db.VarChar(200)
  adv          String   @default("") @db.VarChar(200)
  collocations String   @default("")
  topic        String[] @default([])
  /// Ілюстрація до прикладу вживання: лише посилання на CDN Pexels, не сам файл.
  imageUrl     String?  @map("image_url") @db.VarChar(500)
  imageAuthor  String?  @map("image_author") @db.VarChar(200)
  imagePageUrl String?  @map("image_page_url") @db.VarChar(500)
  /// Користувач прибрав картинку — не підбирати автоматично.
  imageHidden  Boolean  @default(false) @map("image_hidden")
  k            Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User                @relation(fields: [userId], references: [username], onDelete: Cascade, onUpdate: Cascade)
  progress CardRandomProgress?

  @@index([userId, name])
  @@map("word_cards")
}

/// Чернетка (Inbox): швидко збережене слово, яке пізніше стане повною карткою.
model WordDraft {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.VarChar(32)
  word      String   @db.VarChar(200)
  meaning   String   @default("") @db.VarChar(500)
  /// Вчитель, який додав слово учню; null — учень додав сам.
  addedBy   String?  @map("added_by") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User  @relation("DraftOwner", fields: [userId], references: [username], onDelete: Cascade, onUpdate: Cascade)
  author User? @relation("DraftAuthor", fields: [addedBy], references: [username], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@map("word_drafts")
}

/// Персональне посилання «додати в чернетку» без входу (для читалок, словників тощо).
/// Токен дає лише одне право — додати слово в чернетку власника; його можна перевипустити.
model DraftLink {
  token     String   @id @db.VarChar(64)
  userId    String   @unique @map("user_id") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [username], onDelete: Cascade, onUpdate: Cascade)

  @@map("draft_links")
}

/// Стан інтервального рандому. Відсутній рядок = картка ще не випадала (крок 1, доступна).
model CardRandomProgress {
  cardId         String   @id @map("card_id") @db.Uuid
  /// Крок, що буде застосовано при наступному випаданні: 1..6 (lock = 5 * n днів).
  repetitionStep Int      @map("repetition_step") @db.SmallInt
  lockedUntil    DateTime @map("locked_until") @db.Timestamptz(3)

  card WordCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([lockedUntil])
  @@map("card_random_progress")
}

/// Refresh-токени (JWT з jti). Зберігаємо для ротації, відкликання та виявлення повторного використання.
model RefreshToken {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.VarChar(32)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [username], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
