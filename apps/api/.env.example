# Скопіюйте у .env і змініть секрети
PORT=3000
DATABASE_URL=postgresql://wl:wl@localhost:5432/word_learning?schema=public

# Мінімум 32 символи; згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters

# Secure-куки. Браузери дозволяють Secure-куки на http://localhost, тож true працює і в dev.
COOKIE_SECURE=true

# Картинки до «Прикладу вживання». Безкоштовний ключ: https://www.pexels.com/api/
# Порожньо — функція просто вимкнена.
PEXELS_API_KEY=

# Потрібно лише якщо фронт на іншому origin (без dev-proxy). Напр. http://localhost:4200
WEB_ORIGIN=
